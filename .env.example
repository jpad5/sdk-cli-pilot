# Copy to .env and fill in for live mode. Never commit .env.
DEMO_MODE=mock

# --- Foundry (lab 01, 02, 06) ---
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1-mini
FOUNDRY_AGENT_NAME=kyc-aml-agent

# --- Sanctions MCP server (lab 02) ---
MCP_SANCTIONS_URL=http://localhost:8765/mcp

# --- Observability (lab 07) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- M365 Agents SDK host (lab 03) ---
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=

# --- Copilot Studio (lab 04) ---
COPILOTSTUDIOAGENT__ENVIRONMENTID=
COPILOTSTUDIOAGENT__SCHEMANAME=
COPILOTSTUDIOAGENT__TENANTID=
COPILOTSTUDIOAGENT__AGENTAPPID=

# --- Governance (lab 09) ---
KYC_ALLOWED_TOOLS=screen_name,risk_score,draft_sar,lookup_customer
SAR_AUTO_APPROVE=false
